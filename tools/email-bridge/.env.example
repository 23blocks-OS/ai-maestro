# Which mailbox(es) to watch (must match an email in the credentials file) and where AI Maestro is
WATCHED_ACCOUNTS=you@example.com
AIMAESTRO_URL=http://127.0.0.1:23000
DEFAULT_RECIPIENT=pas-lola
HOST_ID=mini-lola
# CREDENTIALS_FILE=~/lola/brain/companies-credentials.yaml   (the default shown; the file holds the mailbox login)

# off = one notification per mail (today); shadow = the same plus a classification log; on = the split
SPLIT_MODE=shadow
# The receiving mail server's authserv-id. Empty means nobody is trusted. The shadow week logs the ids it sees.
AUTHSERV_ID=
# The WAKE class: operator addresses (exact), or @domain for exactly that domain
TRUSTED_SENDERS=
# The COMPANY class: bare domains. Authenticated mail from them goes into the digest, labelled, and never wakes anyone
COMPANY_DOMAINS=
# DIGEST_RECIPIENT=pas-lola
# DIGEST_TIMES=08:00,13:00,18:00
# DIGEST_MAX_PENDING=25
# DIGEST_SUBJECTS=true
# TRUSTED_INCLUDE_BODY=false
# POLL_INTERVAL_MS=120000        (default 120000 with SPLIT_MODE=on, 900000 otherwise)
# DRY_RUN=true                    (log what would be sent, send nothing, write no state)
# IMAP_INSECURE_TLS=true          (only if the mail server's certificate cannot be verified)
