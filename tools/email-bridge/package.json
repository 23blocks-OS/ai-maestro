{
  "name": "aimaestro-email-bridge",
  "version": "0.2.0",
  "private": true,
  "description": "Email bridge for AI Maestro: polls IMAP, wakes an agent for trusted authenticated mail, digests the rest",
  "main": "src/email-bridge.ts",
  "scripts": {
    "start": "tsx src/email-bridge.ts",
    "dev": "tsx watch src/email-bridge.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^16.6.0",
    "imap": "^0.8.19",
    "mailparser": "^3.7.1",
    "tldts": "^6.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/imap": "^0.8.40",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
