    "pg": "^8.16.3",
    "react": "^19",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^19",
    "source-map-support": "^0.5.21",
    "three": "^0.169.0",
    "ts-morph": "^27.0.2",
    "tsx": "~4.21.0",
    "uuid": "^13.0.1",
    "ws": "^8.21.0",
    "yauzl": "^3.2.1"
  },
  "devDependencies": {
