    "@types/yauzl": "^2.10.3",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.0",
    "to-ico": "^1.1.5",
